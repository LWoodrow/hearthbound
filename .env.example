# Local AI Dungeon Master
OLLAMA_URL=http://127.0.0.1:11434
# Versioned profile; Qwen remains active unless this is explicitly changed.
DND_MODEL_PROFILE=qwen3-local-v1
DND_MODEL=qwen3:14b-q4_K_M
# Evaluation only: set DND_MODEL_PROFILE=gemma4-12b-eval-v1 and adjust this tag after installation.
# GEMMA_MODEL=gemma4:12b
# Optional local debugging endpoint. Hidden and player-private content stays redacted.
# DND_PROMPT_INSPECTOR=1
# Optional browser playtest checklist. Use with a separate disposable DND_DATABASE.
# DND_PLAYTEST_TOOLS=1

# Optional OpenAI-compatible Whisper transcription endpoint
# WHISPER_URL=http://127.0.0.1:8080/v1/audio/transcriptions
# WHISPER_MODEL=whisper-1

# Optional Automatic1111/Forge-compatible local scene image endpoint
# HEARTHBOUND_IMAGE_API_URL=http://127.0.0.1:7860/sdapi/v1/txt2img

# Required for push-to-talk from iPads. Both files must be PEM formatted.
# HTTPS_KEY=certificates/hearthbound-key.pem
# HTTPS_CERT=certificates/hearthbound-cert.pem

HOST=0.0.0.0
PORT=4173
